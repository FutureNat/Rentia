{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .wrangler --ignore-pattern work",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:integration": "node scripts/test-connection-health.cjs && node scripts/test-meli-billing.cjs && node scripts/test-mercadolibre-lifetime.mjs && node scripts/test-mercadolibre-oauth.cjs && node scripts/test-mercadolibre-worker.mjs && node scripts/test-mercadolibre.cjs && node scripts/test-product-ads-refunds.cjs",
    "local:db": "node scripts/local-db.mjs",
    "local": "vinext build && wrangler dev -c dist/server/wrangler.json --port 5174 --ip 127.0.0.1 --persist-to .wrangler/state --env-file .env.local"
  },
  "dependencies": {
    "@clerk/localizations": "^4.17.1",
    "@clerk/nextjs": "^7.9.4",
    "lucide-react": "0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
